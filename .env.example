# ── Database ────────────────────────────────────────────────────────────────
# Neon Postgres "pooled" connection string (https://neon.tech → Project → Dashboard).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-region-1.aws.neon.tech/neondb?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=""

# ── Admin seed (used only by `npm run migrate`) ─────────────────────────────
ADMIN_EMAIL="admin@buk.edu.ng"
ADMIN_PASSWORD="Admin123!"
# Set to "true" once to overwrite the existing admin's password with ADMIN_PASSWORD (fixes 401s)
RESET_ADMIN_PASSWORD="false"
# Optional: also seed demo doctors (dr.bello@ / dr.danladi@ / dr.yusuf@buk.edu.ng, password Doctor123!)
# and the demo student musa.ibrahim@student.buk.edu.ng (Student123!) shown on the login page
SEED_DEMO="false"

# Optional: self-hosted Jitsi domain (default meet.jit.si)
# NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
